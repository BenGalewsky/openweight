{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lumen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lumen",
      "options": {
        "baseURL": "https://lumen.ncsa.illinois.edu/v1",
        "apiKey": "{env:LUMEN_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "glm-5.3 via Lumen",
          "limit": { "context": 524282, "output": 131072 },
          "cost": { "input": 1.321413, "output": 4.248318, "cache_read": 1.321413 },
          "modalities": { "input": ["text"], "output": ["text"] }
        },
        "qwen3.8-flash": {
          "name": "qwen3.8-flash via Lumen",
          "limit": { "context": 262138, "output": 131072 },
          "cost": { "input": 0.142798, "output": 0.452902, "cache_read": 0.142798 }
        },
        "ornith-1.0-35b": {
          "name": "ornith-1.0-35b via Lumen",
          "limit": { "context": 262138, "output": 256000 },
          "cost": { "input": 0.05, "output": 0.1, "cache_read": 0.05 },
          "modalities": { "input": ["text"], "output": ["text"] },
          "tool_call": true
        }
      }
    },
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPEN_ROUTER_KEY}"
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3-Flash via OpenRouter",
          "limit": { "context": 1048576, "output": 131072 },
          "cost": { "input": 0.0285, "output": 0.0923, "cache_read": 0.0285 }
        }
      }
    }
  },
  "permissions": [{ "action": "*", "resource": "*", "effect": "allow" }],
  "mcp": {
    "servers": {
      "svelte": { "type": "remote", "url": "https://mcp.svelte.dev/mcp" }
    }
  },
  "skills": [
    "{env:OPENWEIGHT_HARNESS_CONFIG}/plugins/dagster-expert/skills",
    "{env:OPENWEIGHT_HARNESS_CONFIG}/plugins/dignified-python/skills"
  ]
}
