# MLflow tracking server (used by the runner, Claude Code hooks, and the OpenCode plugin)
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# All evaluation runs, traces, and review scores are logged to this experiment
MLFLOW_EXPERIMENT_ID=

# Claude Code inside the sandbox: subscription token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# OpenCode models served by NCSA Lumen (https://lumen.ncsa.illinois.edu/v1)
LUMEN_API_KEY=
