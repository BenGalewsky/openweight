# Secrets
.env
.env.*
!.env.example

# Source Access databases (benchmark inputs, kept local; db/access_db_schema.sql is tracked)
*.accdb
*.laccdb

# data/ holds tracked logger fixtures; Access extracts are produced by each agent, never kept here
data/*.json
data/*.ndjson

# Evaluation workspaces (git worktrees for eval/* branches) and run artifacts
workspaces/
runs/
reviews/*.local.*

# Local MLflow fallback store
mlruns/
mlartifacts/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node (if any tooling is added on main)
node_modules/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Claude Code local settings (shared settings live in .claude/settings.json)
.claude/settings.local.json
